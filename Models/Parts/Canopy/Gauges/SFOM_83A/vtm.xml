<?xml version="1.0" encoding="utf-8"?>

<PropertyList>
	<path>vtm.ac</path>

  <animation>
    <!-- object name in ac file -->
    <object-name>vtm_ac_object</object-name>
  </animation>

  <!--  REMBRANDT support for transparent objects-->
  <effect>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>vtm_ac_object</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>vtm_ac_object</object-name>
    <emission>
      <red> 1 </red>
      <green> 1 </green>
      <blue> 1 </blue>
    </emission>
  </animation>


</PropertyList>
